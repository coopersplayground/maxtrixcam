#!/usr/bin/env python3
"""
matrix-cam - Watch security cameras in Matrix-style ASCII art.

Falling katakana rain over a live camera feed, rendered in your terminal.
Supports RTSP network cameras and USB webcams (v4l2).
Auto-detects Frigate NVR cameras or use manual sources.

Usage: matrix-cam
"""
import subprocess, sys, os, re, time, random, threading, shutil, json

SETTINGS_FILE = os.path.expanduser("~/.matrix-cam.json")
CHARS = " .:-=+*#%@"
MATRIX_CHARS = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789$#@%&*+=<>?Z"
RAIN_FPS = 10

GREEN = "\033[92m"
BRIGHT = "\033[97;1m"
RESET = "\033[0m"

DEFAULTS = {
    "feed_fps": 5,
    "rain_density": 0.7,
    "trail": 5,
    "mirror": True,
    "names": {},
    "frigate_config": "",
    "sources": {},
}

def load_settings():
    s = dict(DEFAULTS)
    try:
        s.update(json.load(open(SETTINGS_FILE)))
    except Exception:
        pass
    return s

def save_settings(s):
    try:
        json.dump(s, open(SETTINGS_FILE, "w"), indent=1)
    except Exception:
        pass

SETTINGS = load_settings()

base_grid = None
grid_lock = threading.Lock()
stop_flag = False

def get_cameras():
    """Return {name: (kind, source)}. Manual sources first, then Frigate auto-detect."""
    cams = {}
    # manual sources from settings
    for name, src in SETTINGS.get("sources", {}).items():
        kind = src.get("kind", "rtsp")
        if kind == "rtsp" and src.get("url"):
            cams[name] = ("rtsp", src["url"])
        elif kind == "v4l2" and src.get("device"):
            cams[name] = ("v4l2", src["device"])
    # Frigate auto-detect
    cfg = SETTINGS.get("frigate_config") or os.environ.get("FRIGATE_CONFIG", "")
    if cfg and os.path.exists(cfg):
        try:
            txt = open(cfg).read()
            m = re.search(r"go2rtc:\s*\n\s*streams:\s*\n((?:\s+\w+:.*\n(?:\s+- .*\n?)*)+)", txt)
            if m:
                for cm in re.finditer(r"^\s{4}(\w+):\s*\n\s+-\s+(rtsp://\S+)", m.group(1), re.M):
                    if cm.group(1) not in cams:
                        cams[cm.group(1)] = ("rtsp", cm.group(2))
            cm2 = re.search(r"^cameras:\s*\n(.*?)(?=^[a-z_]+:\s*$|\Z)", txt, re.M | re.S)
            if cm2:
                blocks = re.split(r"(?m)^(?=  \w+:)", cm2.group(1))
                for b in blocks:
                    nm = re.match(r"  (\w+):", b)
                    pm = re.search(r"/dev/v4l/\S+", b)
                    if nm and pm and nm.group(1) not in cams:
                        cams[nm.group(1)] = ("v4l2", pm.group(0))
        except Exception as e:
            print(f"Could not read Frigate config: {e}", file=sys.stderr)
    return cams

def display_name(name):
    return SETTINGS["names"].get(name, name)

def term_size():
    s = shutil.get_terminal_size((200, 50))
    return s.columns, s.lines - 3

def frame_to_grid(path):
    from PIL import Image
    tw, th = term_size()
    img = Image.open(path).convert("L")
    new_h = int(tw * (img.size[1] / img.size[0]) * 0.55)
    new_h = min(new_h, th)
    if new_h == th:
        tw = int(th / 0.55 / (img.size[1] / img.size[0]))
    img = img.resize((tw, new_h))
    px = img.load()
    grid = [[CHARS[min(px[x, y] * len(CHARS) // 256, len(CHARS) - 1)]
             for x in range(tw)] for y in range(new_h)]
    if SETTINGS.get("mirror", True):
        grid = [row[::-1] for row in grid]
    return grid

def ffmpeg_input_args(kind, source):
    if kind == "v4l2":
        return ["-f", "v4l2", "-framerate", "30", "-video_size", "1280x720",
                "-input_format", "mjpeg", "-i", source]
    return ["-rtsp_transport", "tcp", "-i", source]

def cam_worker(kind, source):
    global base_grid, stop_flag
    tmp = "/tmp/matrix-cam-frame.jpg"
    fps = SETTINGS["feed_fps"]
    while not stop_flag:
        try:
            proc = subprocess.Popen(
                ["ffmpeg", "-v", "error"] + ffmpeg_input_args(kind, source) +
                ["-vf", f"fps={fps}", "-q:v", "3",
                 "-f", "image2pipe", "-vcodec", "mjpeg", "-"],
                stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
            buf = b""
            while not stop_flag:
                chunk = proc.stdout.read(65536)
                if not chunk:
                    break
                buf += chunk
                while True:
                    s = buf.find(b"\xff\xd8")
                    e = buf.find(b"\xff\xd9", s + 2)
                    if s < 0 or e < 0:
                        break
                    jpg = buf[s:e + 2]
                    buf = buf[e + 2:]
                    try:
                        open(tmp, "wb").write(jpg)
                        grid = frame_to_grid(tmp)
                        with grid_lock:
                            base_grid = grid
                    except Exception:
                        pass
            proc.terminate()
            try:
                proc.wait(timeout=5)
            except Exception:
                proc.kill()
        except Exception:
            pass
        time.sleep(1)

def scramble_prob(dist):
    trail = SETTINGS["trail"]
    if dist < 0 or dist > trail:
        return 0.0
    return 0.90 - (dist / trail) * 0.85

def render_matrix(grid, drops):
    h = len(grid)
    w = len(grid[0]) if h else 0
    out = []
    for y in range(h):
        line = []
        for x in range(w):
            d = drops[x] - y
            p = scramble_prob(d)
            if p > 0 and random.random() < p:
                ch = random.choice(MATRIX_CHARS)
                if d == 0:
                    line.append(f"{BRIGHT}{ch}{GREEN}")
                else:
                    line.append(ch)
            else:
                line.append(grid[y][x])
        out.append("".join(line))
    return "\n".join(out)

def options_menu(cams):
    while True:
        os.system("clear")
        print(f"{GREEN}=== OPTIONS ==={RESET}\n")
        print(f"  1. Feed frame rate      [{SETTINGS['feed_fps']} fps]")
        print(f"  2. Rain density         [{int(SETTINGS['rain_density']*100)}%]")
        print(f"  3. Trail length         [{SETTINGS['trail']} chars]")
        print(f"  4. Mirror image         [{'On' if SETTINGS.get('mirror', True) else 'Off'}]")
        print(f"  5. Rename cameras")
        print(f"  6. Back")
        print()
        try:
            c = input("Choose: ").strip()
        except EOFError:
            return
        if c == "1":
            try:
                v = int(input(f"Feed fps (1-30) [{SETTINGS['feed_fps']}]: ").strip() or SETTINGS["feed_fps"])
                SETTINGS["feed_fps"] = max(1, min(30, v))
            except ValueError:
                pass
        elif c == "2":
            try:
                v = int(input(f"Rain density % (10-100) [{int(SETTINGS['rain_density']*100)}]: ").strip() or int(SETTINGS["rain_density"]*100))
                SETTINGS["rain_density"] = max(0.1, min(1.0, v / 100))
            except ValueError:
                pass
        elif c == "3":
            try:
                v = int(input(f"Trail length (1-15) [{SETTINGS['trail']}]: ").strip() or SETTINGS["trail"])
                SETTINGS["trail"] = max(1, min(15, v))
            except ValueError:
                pass
        elif c == "4":
            SETTINGS["mirror"] = not SETTINGS.get("mirror", True)
        elif c == "5":
            rename_menu(cams)
        elif c == "6":
            save_settings(SETTINGS)
            return
        save_settings(SETTINGS)

def rename_menu(cams):
    names = list(cams.keys())
    while True:
        os.system("clear")
        print(f"{GREEN}=== RENAME CAMERAS (app only) ==={RESET}\n")
        for i, n in enumerate(names, 1):
            print(f"  {i}. {n} -> {display_name(n)}")
        print(f"  {len(names)+1}. Back")
        print()
        try:
            c = input("Choose camera to rename: ").strip()
            idx = int(c) - 1
            if idx == len(names):
                return
            old = names[idx]
            new = input(f"New display name for '{old}' [{display_name(old)}]: ").strip()
            if new:
                SETTINGS["names"][old] = new
                save_settings(SETTINGS)
        except (ValueError, IndexError, EOFError):
            return

def watch(name, kind, source):
    global stop_flag, base_grid
    stop_flag = False
    base_grid = None
    dname = display_name(name)
    print(f"\nStarting {dname}...\n")

    tmp = "/tmp/matrix-cam-frame.jpg"
    try:
        subprocess.run(["ffmpeg", "-y", "-v", "error"] + ffmpeg_input_args(kind, source) +
                       ["-vframes", "1", "-q:v", "3", tmp],
                       timeout=20, capture_output=True)
        base_grid = frame_to_grid(tmp)
    except Exception as e:
        print(f"Could not grab initial frame: {e}")
        return

    h, w = len(base_grid), len(base_grid[0])
    density = SETTINGS["rain_density"]
    drops = [random.randint(0, h - 1) if random.random() < density else -1000 for _ in range(w)]
    speeds = [random.choice([1, 1, 2]) for _ in range(w)]

    t = threading.Thread(target=cam_worker, args=(kind, source), daemon=True)
    t.start()

    frame_time = 1.0 / RAIN_FPS
    try:
        while True:
            t0 = time.time()
            with grid_lock:
                grid = [row[:] for row in base_grid] if base_grid else None
            if grid:
                gh, gw = len(grid), len(grid[0])
                if len(drops) != gw:
                    drops = [random.randint(0, gh - 1) if random.random() < density else -1000 for _ in range(gw)]
                    speeds = [random.choice([1, 1, 2]) for _ in range(gw)]
                for x in range(gw):
                    if drops[x] < -500:
                        if random.random() < 0.02:
                            drops[x] = random.randint(-SETTINGS["trail"], 0)
                        continue
                    drops[x] += speeds[x]
                    if drops[x] - SETTINGS["trail"] > gh:
                        drops[x] = -1000 if random.random() > density else random.randint(-SETTINGS["trail"], 0)
                        speeds[x] = random.choice([1, 1, 2])
                sys.stdout.write("\033[H")
                sys.stdout.write(f"{GREEN}=== {dname} (matrix live) ===  Ctrl+C to stop\n")
                sys.stdout.write(render_matrix(grid, drops))
                sys.stdout.write(RESET)
                sys.stdout.flush()
            elapsed = time.time() - t0
            time.sleep(max(0, frame_time - elapsed))
    except KeyboardInterrupt:
        pass
    finally:
        stop_flag = True
        print(f"{RESET}\nStopped.")

def main():
    cams = get_cameras()
    if not cams:
        print("No cameras found. Add sources to ~/.matrix-cam.json or set FRIGATE_CONFIG.")
        print('Example: {"sources": {"front": {"kind": "rtsp", "url": "rtsp://user:pass@host/stream"}}}')
        return
    names = list(cams.keys())
    while True:
        os.system("clear")
        print(f"{GREEN}=== MATRIX CAM ==={RESET}\n")
        for i, n in enumerate(names, 1):
            print(f"  {i}. {display_name(n)}")
        print(f"  {len(names)+1}. Options")
        print(f"  {len(names)+2}. Quit")
        print()
        try:
            c = input("Choose: ").strip()
            idx = int(c) - 1
        except (ValueError, EOFError):
            continue
        if idx == len(names):
            options_menu(cams)
        elif idx == len(names) + 1:
            print("Bye.")
            return
        elif 0 <= idx < len(names):
            kind, source = cams[names[idx]]
            watch(names[idx], kind, source)

if __name__ == "__main__":
    main()
